# Python
__pycache__/
*.pyc
*.pyo

# Virtual environments
venv/
network/venv/

# Environment files
.env

# SQLite: recreated and reseeded by database.init_db() on first run
*.db

# Generator scratch output (regenerated by the generators in backend/)
backend/docker_topologies/
backend/test_topologies/
backend/test_docker_output/
generated_topologies/
backend/docker_training/

# Trained model pickles (recreated by backend/train_model.py --skip-docker)
*.pkl

# The lab generated from the designer topology (rebuilt by POST /api/lab/deploy)
backend/labs/

# Logs
*.log

# Runtime state written by start.sh (pids, per-run logs)
.run/
backend/.venv-install-stamp

# VS Code
.vscode/

# macOS/Linux
.DS_Store
